{
  "name": "@a2net/mcp",
  "version": "0.1.0",
  "description": "Open-Source A2Net ↔ MCP (Model Context Protocol) bidirectional interoperability gateway",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
