{
  "name": "@a2net/client",
  "version": "0.1.0",
  "description": "Open-Source Client SDK for the A2Net Agent Interoperability Protocol",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "a2net",
    "agent",
    "did",
    "e2ee",
    "interoperability",
    "p2p",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Datalong/Open_SDK.git",
    "directory": "sdks/typescript"
  },
  "homepage": "https://github.com/Datalong/Open_SDK#readme",
  "bugs": {
    "url": "https://github.com/Datalong/Open_SDK/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./langchain": {
      "types": "./dist/integrations/langchain.d.ts",
      "import": "./dist/integrations/langchain.js"
    },
    "./ollama": {
      "types": "./dist/integrations/ollama.d.ts",
      "import": "./dist/integrations/ollama.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "^1.4.0",
    "@noble/hashes": "^1.4.0",
    "@scure/bip39": "^1.3.0",
    "bs58": "^5.0.0",
    "hash-wasm": "^4.11.0",
    "uuid": "^9.0.1",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
